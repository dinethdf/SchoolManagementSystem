# .env.example
# Copy this file to .env and fill in your actual configuration values.
# IMPORTANT: Never commit your real .env file with actual passwords to GitHub!

# Django Secret Key (generate a random string for production)
SECRET_KEY=django-insecure-school-management-system-secret-key-change-in-production

# Debug Mode: Set to True for development, False for production
DEBUG=True

# Database Engine: 'mysql' for MySQL (default), 'sqlite3' for SQLite fallback
DB_ENGINE=mysql

# MySQL Database Configuration
DB_NAME=school_management_system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed Frontend URLs for CORS (cross-origin API calls)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
