# ==========================================
# School Management System — .gitignore
# ==========================================

# ─── Node / Frontend ──────────────────────
node_modules/
dist/
dist-ssr/
*.local
.cache/
.parcel-cache/
frontend/.env
frontend/.env.local
frontend/.env.production

# ─── Python / Backend ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
MANIFEST
.Python
develop-eggs/
downloads/
.installed.cfg

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Django
*.log
*.pot
*.pyc
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/
backend/.env
backend/.env.local

# ─── Environment Variables ────────────────
.env
.env.local
.env.production
.env.staging
# Keep .env.example tracked
!.env.example
!frontend/.env.example
!backend/.env.example

# ─── IDEs & Editors ───────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS Files ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Docker ───────────────────────────────
.docker/

# ─── Testing ──────────────────────────────
coverage/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ─── Logs ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Misc ─────────────────────────────────
*.bak
*.tmp
*.temp
