# ==========================================
# School Management System — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ==========================================

# ─── Django Core ──────────────────────────
SECRET_KEY=your-super-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ─── Database (PostgreSQL) ────────────────
DB_NAME=school_management_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Auth ─────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Email (SMTP) ─────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=School Management <noreply@school.com>

# ─── AI / LLM Provider ────────────────────
# Options: anthropic | openai | google
AI_PROVIDER=anthropic
AI_API_KEY=your-ai-api-key-here
AI_MODEL=claude-3-5-sonnet-20241022

# ─── Payment Gateway (optional) ───────────
PAYMENT_GATEWAY_NAME=stripe
PAYMENT_GATEWAY_PUBLIC_KEY=pk_test_your-key
PAYMENT_GATEWAY_SECRET_KEY=sk_test_your-secret

# ─── Redis (optional — for Celery) ────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── File Uploads ─────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=pdf,doc,docx,jpg,jpeg,png,zip

# ─── Frontend (Vite) ──────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=School Management System
